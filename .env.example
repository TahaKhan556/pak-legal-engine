# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pak_legal
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM API
AI_API_URL=https://llm2.jugaar.ai/v1
AI_API_KEY=your_api_key_here
AI_MODEL=xiaomimimo/mimo-v2.5

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pak-legal-documents
R2_PUBLIC_URL=

# App
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

# Sentry (optional)
SENTRY_DSN=
